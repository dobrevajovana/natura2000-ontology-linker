FROM python:3.11-slim

WORKDIR /app

COPY requirements.mfd.txt .
RUN pip install --no-cache-dir -r requirements.mfd.txt

COPY soil/ ./soil/
# ENVO matching for MFD classes without a Natura 2000 code
COPY geoapp/ ./geoapp/

RUN mkdir -p /data
ENV DATA_DIR=/data
ENV GEO_CACHE_DIR=/data/cache

EXPOSE 8095

# Reads the MFD ontology from its URL on start, then serves it.
CMD ["python", "-m", "soil.app"]
