# Local configuration. `.env` is ignored as well as `.env.local`: it is where an
# NCBI_API_KEY would live, and a key must never reach the repository.
.env
.env.*
!.env.example

# Pipeline artefacts and the on-disk HTTP cache: all regenerable, and large.
data/
*.log

# Python
*.pyc
__pycache__/
*.egg-info/
dist/
build/
.venv/
venv/

# macOS
.DS_Store

# Deployment and server notes. Host addresses, SSH targets, admin-panel URLs and
# server-side venv/env paths are infrastructure, not source: they must never be
# committed, and this repository is not where they are documented.
*.env
env/
notes*.md
NOTES*.md
deploy*.md
DEPLOY*.md
server*.md
*runbook*
*.pem
*.key
id_rsa*
.ssh/
