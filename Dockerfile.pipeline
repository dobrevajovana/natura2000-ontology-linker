FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.pipeline.txt .
# CPU-only PyTorch: the default Linux wheel bundles CUDA (~2.5 GB) that the embedding step never uses
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir -r requirements.pipeline.txt

COPY pipeline/ ./pipeline/
# Settings come from docker-compose's env_file at run time; .env is never baked into the image.

RUN mkdir -p /data

ENTRYPOINT ["python", "-m", "pipeline.main"]
