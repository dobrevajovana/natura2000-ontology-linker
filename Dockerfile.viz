FROM python:3.11-slim

WORKDIR /app

COPY requirements.viz.txt .
RUN pip install --no-cache-dir -r requirements.viz.txt

COPY viz/ ./viz/
# the ontology manager reuses geoapp's calibrated OLS4 matcher
COPY geoapp/ ./geoapp/
# the MFD habitat ontology viewer is served at /mfd/
COPY mfd/ ./mfd/
# the cloud samples viewer (ENA PRJEB54740) is served at /cloud/
COPY cloud/ ./cloud/
# the VERDANT validator (checks and expert review of any mappings) at /validate/
COPY verdant_validator/ ./verdant_validator/

RUN mkdir -p /data

ENV FLASK_APP=viz/app.py
ENV DATA_DIR=/data
ENV GEO_CACHE_DIR=/data/cache
ENV LINKER_DIR=/data

EXPOSE 8080

CMD ["python", "viz/app.py"]
