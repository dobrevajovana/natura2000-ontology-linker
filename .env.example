# Copy to `.env` and adjust. Every value here is a default that also lives in
# geoapp/config.py, so the app runs without this file at all.

# --- Natura 2000 pipeline (pipeline/) --------------------------------------
SIMILARITY_CLOSE=0.70          # cosine >= this  -> skos:closeMatch (similarity never gives exactMatch)
SIMILARITY_RELATED=0.55        # cosine >= this  -> skos:relatedMatch
OLS4_ONTOLOGIES=envo,ncbitaxon,chebi
EMBEDDING_MODEL=all-MiniLM-L6-v2
API_RATE_LIMIT=1.0             # seconds between external API calls
VIZ_PORT=8080
DRY_RUN_SIZE=50

# --- BioSample geo app (geoapp/) -------------------------------------------
# Optional. With a key NCBI allows 10 req/s instead of 3.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
# NCBI_API_KEY=
# NCBI_EMAIL=

GEO_PORT=8090
GEO_FETCH_WORKERS=8
GEO_OLS4_ONTOLOGIES=envo,ncbitaxon,uberon,po
GEO_OLS4_MIN_SCORE=0.60
GEO_CACHE_TTL_DAYS=30

# --- MFD viewer (mfd/) ----------------------------------------------------------
# Folder on this computer where experts' reviews are saved (default ~/natura2000-reviews).
# MFD_REVIEWS_DIR=/Users/you/natura2000-reviews

# Mapping files to check and review at /validate/ (any linker output, SSSOM or table).
# Default: ~/natura2000-validate. Decisions go to the reviews folder above, under validate/.
# VALIDATE_DIR=/Users/you/natura2000-validate
